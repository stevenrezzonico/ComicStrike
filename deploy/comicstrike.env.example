# ComicStrike server settings for systemd (deploy/comicstrike.service reads this file).
# Copy to /etc/comicstrike/comicstrike.env and keep it private (chmod 600): it holds the rcon password.

# The site and the game on the standard HTTPS port: https://cstrike.click/
# TCP 443 serves the pages over HTTPS, UDP 443 carries the game (WebTransport).
HTTP_PORT=443
GAME_PORT=443
# Plain http:// on port 80 redirects to the HTTPS site.
REDIRECT_PORT=80

# The site's name (shown in the startup line). The certificate itself comes from
# TLS_CERT / TLS_KEY, which the service file sets.
HOSTNAMES=cstrike.click

# IPv4 on every interface. For IPv6 (an AAAA record) use BIND=:: and test both.
BIND=0.0.0.0

# The map the server starts on (maps/<MAP>.bsp).
MAP=de_dust2

# Enables rcon for this password (the console's `rcon <command>`). Change it.
RCON_PASSWORD=change-me
