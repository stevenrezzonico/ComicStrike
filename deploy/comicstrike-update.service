# Pulls the newest commit of the repository into /opt/comicstrike and restarts the game
# (deploy/update.sh, installed as /usr/local/bin/comicstrike-update: outside the checkout, which
# the script itself rewrites); run by comicstrike-update.timer. Install both units in /etc/systemd/system.

[Unit]
Description=ComicStrike: deploy the newest commit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/comicstrike-update
