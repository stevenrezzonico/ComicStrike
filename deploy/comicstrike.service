# ComicStrike game server as a systemd service (see deploy/README.md).
# Install: /etc/systemd/system/comicstrike.service
# Needs systemd 249 or newer (Debian 12, Ubuntu 22.04, DietPi on Bookworm) for LoadCredential with %d.

[Unit]
Description=ComicStrike game server
After=network-online.target
Wants=network-online.target

[Service]
User=comicstrike
Group=comicstrike
WorkingDirectory=/opt/comicstrike
EnvironmentFile=/etc/comicstrike/comicstrike.env

# The Let's Encrypt certificate, read by systemd as root and handed to the server
# (the private key stays readable by root only on disk).
LoadCredential=fullchain.pem:/etc/letsencrypt/live/cstrike.click/fullchain.pem
LoadCredential=privkey.pem:/etc/letsencrypt/live/cstrike.click/privkey.pem
Environment=TLS_CERT=%d/fullchain.pem
Environment=TLS_KEY=%d/privkey.pem

# Deno's cache (it writes compiled code there): /var/cache/comicstrike.
CacheDirectory=comicstrike
Environment=DENO_DIR=/var/cache/comicstrike
Environment=NO_COLOR=1

ExecStart=/usr/local/bin/deno run --unstable-net --allow-net --allow-read --allow-env server/main.js
StandardInput=null
Restart=on-failure
RestartSec=2

# Ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Read-only system, no home directories, its own /tmp.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
