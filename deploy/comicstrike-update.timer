# Every minute: deploy a new commit if there is one (comicstrike-update.service).
# sudo systemctl enable --now comicstrike-update.timer

[Unit]
Description=ComicStrike: check GitHub for a new commit every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
